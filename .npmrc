# ─── PNPM Configuration ───────────────────────────────────────────────────────
# store-dir relativo ao repo — não committado (está no .gitignore)
store-dir=.pnpm-store

# Hoisting controlado para Three.js (R3F)
shamefully-hoist=false
public-hoist-pattern[]=*three*
public-hoist-pattern[]=*@react-three*

# Linkagem de pacotes workspace
link-workspace-packages=true
shared-workspace-lockfile=true
lockfile=true

# CI SAFETY: frozen-lockfile é controlado via flag de CLI no CI (--frozen-lockfile)
# NÃO definir frozen-lockfile=true aqui para não quebrar "pnpm install" em dev
# O CI usa: pnpm install --frozen-lockfile (explícito no workflow)

# npm fallback para Cloud Build do Firebase (webframeworks usa npm internamente)
legacy-peer-deps=true

# Audit level — falha em vulnerabilidades críticas
# audit-level=critical
