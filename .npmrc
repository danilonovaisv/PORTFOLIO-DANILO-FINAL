store-dir=/tmp/pnpm-store-user
shamefully-hoist=false
public-hoist-pattern[]=*three*
public-hoist-pattern[]=*@react-three*
# Firebase Hosting/Frameworks builds the SSR backend with npm inside Cloud Build.
# Keep legacy peer resolution enabled at the source package level so the remote
# builder does not fail on peerOptional conflicts (`firebase-frameworks` vs `sharp`).
legacy-peer-deps=true
