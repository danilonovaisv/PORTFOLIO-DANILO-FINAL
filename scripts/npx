#!/usr/bin/env bash
# scripts/npx - Shim to ensure npx is found even in restricted environments
set -euo pipefail

# Ensure common paths are in PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Try to find npx
if command -v npx > /dev/null 2>&1; then
    exec npx "$@"
elif command -v pnpm > /dev/null 2>&1; then
    # Fallback to pnpm dlx if npx is missing but pnpm is present
    exec pnpm dlx "$@"
else
    echo "❌ Error: npx/pnpm not found in PATH." >&2
    echo "Current PATH: $PATH" >&2
    exit 1
fi
