{
  "mcpServers": {
    "github": {
      "command": "node",
      "args": [
        "scripts/mcp-wrapper.cjs",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "chrome-devtools": {
      "command": "node",
      "args": ["scripts/mcp-wrapper.cjs", "npx", "-y", "chrome-devtools-mcp"]
    },
    "filesystem": {
      "command": "node",
      "args": [
        "scripts/mcp-wrapper.cjs",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/danilonovais/PORTFOLIO-DANILO-FINAL"
      ]
    }
  }
}
