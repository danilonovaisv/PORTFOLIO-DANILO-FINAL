 suporte da tecnologia de pagamentos.","highlights":["AI Vídeo","Roteiro","Vídeo"],"gallery":["https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/advertising_video/gallery/VIDEO-COMERCIO-LOJA-MERCADO-PAGO-1920x1080px_compressed-mp4.mp4","https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/advertising_video/gallery/VIDEO-COMERCIO-LOJA-MERCADO-PAGO-1080x1080px_compressed-mp4.mp4","https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/AI video/gallery/VIDEO-COMERCIO-LOJA-MERCADO-PAGO-1080x1080px_compressed-mp4.mp4","https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/AI video/gallery/VIDEO-COMERCIO-LOJA-MERCADO-PAGO-1920x1080px_compressed-mp4.mp4"]},"accentColor":"#8705f2","isFeatured":true,"featuredOnHome":true,"featuredOnPortfolio":true,"videoPreview":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/advertising_video/thumb.mp4","landingPageSlug":null},{"id":"8ea6cb05-fee6-496c-87b1-e6c8f7af8cc0","slug":"key-vision","title":" Swift Week","subtitle":"Branding promocional com identidade forte","client":"Swift","category":"campanha","displayCategory":"Campanhas & Advertising","tags":["Key Visual","Campanha Digital","Campanha de Lançamento"],"year":2024,"image":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/key-vision/thumb.webp","imageLandscape":"$undefined","imageSquare":"$undefined","thumbnailMedia":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/key-vision/thumb.webp","type":"B","layout":{"cols":"md:col-span-4 lg:col-span-4","height":"min-h-[320px]","aspectRatio":"aspect-[4/5]","sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 33vw, 33vw","size":"sm"},"detail":{"description":"Key visual construído para consolidar um território promocional próprio. Minimalismo, cor proprietária e in