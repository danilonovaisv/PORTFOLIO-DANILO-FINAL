p4.mp4"]},"accentColor":"#ff3366","isFeatured":true,"featuredOnHome":true,"featuredOnPortfolio":true,"videoPreview":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/key-visual/thumb.mp4","landingPageSlug":"key-vision"},{"id":"00c9df1f-ec23-42e5-9010-1e3e8787520f","slug":"print-design","title":"Hellmann’s — Parcerias que geram valor","subtitle":"Promoções passam. Parcerias permanecem.","client":"Unilever","category":"branding","displayCategory":"Branding & Identity","tags":["Packing","Impresso","Embalagem"],"year":2020,"image":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/print-design/cover-16x9.mp4","imageLandscape":"$undefined","imageSquare":"$undefined","thumbnailMedia":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/print-design/cover-16x9.mp4","type":"B","layout":{"cols":"md:col-span-4 lg:col-span-4","height":"min-h-[320px]","aspectRatio":"aspect-[4/5]","sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 33vw, 33vw","size":"sm"},"detail":{"description":"Este projeto nasce da proposta de transformar ações promocionais em plataformas de parceria de longo prazo. Mais do que incentivar a compra, a ideia foi criar pontos de contato relevantes entre Hellmann’s, grandes parceiros nacionais e o consumidor.\n\nA direção de arte valoriza o cotidiano e o contexto real de uso da marca, integrando Hellmann’s de forma natural a ambientes como mercados, padarias, açougues e redes de alimentação. Cada aplicação foi pensada para funcionar como experiência, não como anúncio.\n\nO sistema visual é flexível e consistente, permitindo adaptação a diferentes parceiros e formatos sem perder reconhecimento de marca. Assim, as promoções deixam de ser pontuais e passam a construir relacionamento, presença e valor compartilhado ao longo do tempo.","highlights":["Packing","Impresso","Embalagem"],"gallery":["https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/print-design/gallery/converted-1-webp.webp"]},"accentColor":"#0057ff","isFeatured":true,"featuredOnHome":true,"featuredOnPortfolio":true,"videoPreview":"https://umkmwbkwvulxtdodzmzf.supabase.co/storage/v1/object/public/portfolio-media/projects/print-design/cover-16x9.mp4","landingPageSlug":"hellmmas"}]}],"$L17"]
