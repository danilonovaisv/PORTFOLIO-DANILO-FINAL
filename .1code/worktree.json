{
  "setup-worktree": [
    "pnpm install",
    "cp $ROOT_WORKTREE_PATH/.env .env",
    "cp $ROOT_WORKTREE_PATH/.env.local .env.local",
    "cp $ROOT_WORKTREE_PATH/.env.production .env.production",
    "mkdir -p supabase-asset-migrate && cp $ROOT_WORKTREE_PATH/supabase-asset-migrate/.env supabase-asset-migrate/.env"
  ]
}
