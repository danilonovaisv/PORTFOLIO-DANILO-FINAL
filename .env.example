NEXT_PUBLIC_SUPABASE_URL=https://umkmwbkwvulxtdodzmzf.supabase.co
NEXT_PUBLIC_SUPABASE_FALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# Compat alias (legacy env name)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...replace_me

# Firebase public web config
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:replace_me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-side vars
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_secret

# Optional integrations
OPENAI_API_KEY=sk-proj-replace_me

# Site / SEO
NEXT_PUBLIC_SITE_URL=https://portfoliodanilo.com

# Cloudflare Turnstile (contact form bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAreplaceMe
TURNSTILE_SECRET_KEY=0x4AAAAAAAreplaceMe_secret

# Feature flags
NEXT_PUBLIC_DISABLE_3D=false
NEXT_PUBLIC_PLAYWRIGHT_TEST=false

# Supabase image hosts (comma-separated, used in next.config.mjs)
NEXT_PUBLIC_SUPABASE_IMAGE_HOSTS=umkmwbkwvulxtdodzmzf.supabase.co

# Admin RBAC controls
# ADMIN_ENFORCE_ROLE=true (default: true)
# ADMIN_ALLOWED_EMAILS=admin@yourdomain.com,owner@yourdomain.com

# MCP Configuration
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_replace_me_with_your_token
